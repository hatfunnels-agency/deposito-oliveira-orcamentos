# ==========================================
# BLING OAuth 2.0
# ==========================================
# Client ID do seu app no Bling
BLING_CLIENT_ID=bd89325028de51355b21d0d0c8f8a384653d9f02

# Client Secret do app Bling (nao commitar o valor real)
BLING_CLIENT_SECRET=

# Refresh Token - obtido apos autorizar em /api/bling/auth
# Copiar do callback e salvar aqui
BLING_REFRESH_TOKEN=

# ==========================================
# SUPABASE
# ==========================================
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vfdoaocrafbcktnkhyvo.supabase.co

# Service Role Key (nao commitar o valor real)
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# CONFIGURACOES DO DEPOSITO
# ==========================================
# CEP do deposito para calculo de frete
DEPOSITO_CEP=06380021

# Google Maps API (opcional - para frete por distancia real)
# GOOGLE_MAPS_API_KEY=

# URL base da aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# GOOGLE ADS - Conversao offline (Venda Confirmada)
# ==========================================
# Mesmas credenciais do app OAuth usado pela skill google-ads-ratos.
# Quando um pedido entra em "Entrega Pendente" ou adiante, o valor da venda
# e enviado ao Google Ads (via gclid) pra habilitar ROAS e Smart Bidding por valor.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC Hat Funnels (sem hifens)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=4931586507
# Conta do Deposito Oliveira (sem hifens)
GOOGLE_ADS_CUSTOMER_ID=8874192074
# Conversion action "Venda Confirmada (Offline)" (default ja aponta pra ela)
GOOGLE_ADS_CONVERSION_ACTION_ID=7650060478
# Conversao enviada via Data Manager API (events:ingest). O refresh token
# precisa do escopo .../auth/datamanager (alem de adwords/analytics).

# ==========================================
# GHL - Sync de CRM (necessario tambem pro gclid das conversoes)
# ==========================================
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
# ID do custom field "gclid" no GHL (mesmo valor usado na landing deposito-site).
# Sem ele, o app tenta a atribuicao nativa do GHL como fallback.
GHL_GCLID_FIELD_ID=